{
  "components": {
    "schemas": {
      "AddressIn": {
        "description": "The delivery address. The recipient's name and phone come from the contact.",
        "properties": {
          "city": {
            "maxLength": 100,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "company": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "country": {
            "const": "GB",
            "default": "GB",
            "title": "Country",
            "type": "string"
          },
          "line1": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Line1",
            "type": "string"
          },
          "line2": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
