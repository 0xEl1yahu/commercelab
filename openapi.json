    "/images/{key}": {
      "get": {
        "operationId": "get_image_images__key__get",
        "parameters": [
          {
            "description": "sha256 of the bytes",
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "description": "sha256 of the bytes",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Key",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "if-none-match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/jpeg": {},
              "image/png": {},
              "image/webp": {}
            },
            "description": "The image bytes"
          },
          "304": {
            "description": "Not modified: the client's copy (If-None-Match) is current"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Image",
        "tags": [
          "images"
        ]
      }
    },
