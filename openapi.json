    "/checkout": {
      "post": {
        "description": "Place and pay for an order as a guest.\n\nSend the same Idempotency-Key header when retrying (a timeout, a double\nclick): the original order comes back with 200 and the customer is never\ncharged twice. 201 means this request created the order. The order's\nstatus says how payment went: paid, cancelled (declined; a new attempt\nneeds a new key) or pending (outcome unknown; retry with the same key, or\npoll GET /orders/{token}).",
        "operationId": "checkout_checkout_post",
        "parameters": [
          {
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderOut"
                }
              }
            },
            "description": "A retry: the original order, unchanged"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsufficientStockOut"
                }
              }
            },
            "description": "Not enough stock, or key reused"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Checkout",
        "tags": [
          "orders"
        ]
      }
    },
