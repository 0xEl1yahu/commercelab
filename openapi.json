  "info": {
    "title": "CommerceLab",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/cart/quote": {
      "post": {
        "description": "Price the browser's cart: current prices, clamped quantities, VAT and total.\n\nNever a 422 for a stale or oversized cart: unknown or discontinued ids come\nback in `removed`, and quantities above what can be bought are clamped\n(`limited: true`). Reserves nothing.",
        "operationId": "quote_cart_quote_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartQuoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartQuoteOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Quote",
        "tags": [
          "cart"
        ]
      }
    },
    "/categories": {
      "get": {
        "description": "Categories with at least one active product, in nav order.",
        "operationId": "list_categories_categories_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CategoryOut"
                  },
                  "title": "Response List Categories Categories Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
